{
  "name": "auto-tower",
  "version": "0.0.0",
  "private": true,
  "description": "Durable mission control for AI chiefs of staff and distributed Auto-Office execution fleets.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/hosting/node.ts",
    "tower": "tsx src/auth/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "runner": "tsx bin/tower-runner.ts"
  },
  "bin": {
    "tower-runner": "./bin/tower-runner.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^24.19.2",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
